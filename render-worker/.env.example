# Copy to .env (gitignored) and fill in. The service role key belongs here
# and nowhere else — never in the app, never in EXPO_PUBLIC_* anything.
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# POLL_INTERVAL_MS=3000
# SETLOG_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
